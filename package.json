{
  "name": "dsh-our-free-model-composer-credits",
  "version": "1.1.0",
  "description": "dsh-our-free-model 的衍生插件：①在 DSH 对话输入框常驻一枚积分胶囊，显示当前渠道账号余额，点开面板即可秒切优先账号；②给各渠道的模型名加上平台前缀（如 LobsterAI · DeepSeek-V4.1-Flash），同名模型一眼可辨。需先装 dsh-our-free-model（2.5.8 起 WorkBuddy 双渠道已被上游移除）。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-our-free-model",
    "our-free-model",
    "composer",
    "credits",
    "channel-pack"
  ],
  "license": "MIT",
  "author": "liushQAQ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liushQAQ/dsh-our-free-model-composer-credits.git"
  },
  "homepage": "https://github.com/liushQAQ/dsh-our-free-model-composer-credits#readme",
  "bugs": {
    "url": "https://github.com/liushQAQ/dsh-our-free-model-composer-credits/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0"
  }
}
