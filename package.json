{
  "name": "dsh-our-free-model-composer-credits",
  "version": "1.3.0",
  "description": "会话 tab 栏（对话/轨迹/系统监控 右侧）积分胶囊 · 余额读数 + 一键切号（不占用会话框、不压缩原生按钮）",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-our-free-model",
    "our-free-model",
    "composer",
    "credits",
    "channel-pack"
  ],
  "license": "MIT",
  "author": "liushQAQ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liushQAQ/dsh-our-free-model-composer-credits.git"
  },
  "homepage": "https://github.com/liushQAQ/dsh-our-free-model-composer-credits#readme",
  "bugs": {
    "url": "https://github.com/liushQAQ/dsh-our-free-model-composer-credits/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0"
  }
}
